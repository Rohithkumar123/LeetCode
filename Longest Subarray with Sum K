import java.util.Scanner;

class Book{
    public int longestSubArray(int[] arr,int k){
        int sum=0;
        int left=0;
        int right=0;
        int maxLen=0;
        int n=arr.length;

       while(right<n) {
           sum += arr[right];

           while (sum > k) {
               sum = sum - arr[left];
               left++;

           }
           if (sum == k) {
               maxLen = Math.max(maxLen, right - left + 1);
           }
           right++;
       }
       return maxLen;

    }

    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int[] arr=new int[n];
        for(int i=0;i<arr.length;i++){
            arr[i]=sc.nextInt();
        }
        int k=sc.nextInt();
        Book b=new Book();
        System.out.println(b.longestSubArray(arr,k));
    }
}
